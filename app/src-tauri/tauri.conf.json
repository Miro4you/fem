{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Projekt-FEM",
  "version": "0.1.0",
  "identifier": "de.hauck.projektfem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5191",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Projekt-FEM",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "FEM-Festigkeitsanalyse"
  }
}
